+
+@firestore.transactional
+def record_kneeq_callback(transaction, order_ref, update, status, now):
+    order = order_ref.get(transaction=transaction).to_dict()
+    if status == "Approved":
+        update = {**update, "status": "paid", "paid_at": order.get("paid_at") or now}
+    elif order.get("status") == "paid":
+        return
+    elif status in {"inProcessing", "Pending", "WaitingAuthComplete"}:
+        update = {**update, "status": "created"}
+    else:
+        update = {**update, "status": "failed"}
+
+    transaction.set(order_ref, update, merge=True)
+
+
+@firestore.transactional
+def claim_kneeq_purchase(transaction, order_ref, claim, now):
+    order = order_ref.get(transaction=transaction).to_dict()
+    if order.get("meta_purchase_sent"):
+        return "sent", order
+    if (order.get("meta_purchase_claim_until") or 0) > now:
+        return "pending", order
+    transaction.set(order_ref, {
+        "meta_purchase_claim": claim,
+        "meta_purchase_claim_until": now + 300,
+    }, merge=True)
+    return "claimed", order
+
+
+@firestore.transactional
+def finish_kneeq_purchase(transaction, order_ref, claim, result, now):
+    order = order_ref.get(transaction=transaction).to_dict()
+    if order.get("meta_purchase_claim") != claim:
+        return bool(order.get("meta_purchase_sent"))
+
+    sent = bool(result.get("ok") and (result.get("response") or {}).get("events_received") == 1)
+    update = {
+        "meta_purchase_claim": None,
+        "meta_purchase_claim_until": None,
+        "meta_purchase_last_attempt": result,
+    }
+    if sent:
+        update.update(meta_purchase_sent=True, meta_purchase_sent_at=now, meta_purchase_response=result)
+    transaction.set(order_ref, update, merge=True)
+    return sent
+
+
+def deliver_kneeq_purchase(order_ref):
+    claim = uuid.uuid4().hex
+    state, order = claim_kneeq_purchase(db.transaction(), order_ref, claim, int(time.time()))
+    if state != "claimed":
+        return state == "sent"
+
+    result = send_meta_event(
+        order, "Purchase",
+        order.get("purchase_event_id") or order.get("event_id"),
+        order.get("paid_at"),
+    )
+    sent = finish_kneeq_purchase(db.transaction(), order_ref, claim, result, int(time.time()))
+    if sent:
+        save_funnel_event("meta_purchase_sent", {
+            "order_reference": order.get("order_reference"),
+            "product_id": order.get("product_id"),
+            "pixel_key": order.get("pixel_key"),
+            "purchase_event_id": order.get("purchase_event_id") or order.get("event_id"),
+            "meta_ok": True,
+            "meta_status_code": result.get("status_code"),
+            "meta_duration_ms": result.get("duration_ms"),
+        })
+    return sent
+
+
+def acknowledge_wayforpay(request, order_reference):
+    response_time = int(time.time())
+
+    response_signature = wayforpay_signature(
+        [
+            order_reference,
+            "accept",
+            response_time,
+        ]
